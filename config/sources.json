{
 "_说明": "外部源配置：把路径指向你自己抓取/下载的文件。本仓库不含任何第三方数据。",
 "sources": {
  "cbs": {
   "adapter": "CBSCatalogue",
   "path": "data/cbs_catalogue.tsv",
   "_抓取URL模式": "https://wi.knaw.nl/page/fungal_display/name/CBS%20<NUM>"
  },
  "biocollections": {
   "adapter": "Biocollections",
   "path": "data/biocollections_codes.csv",
   "_说明": "**仓库自带精简版**（9,672 行 / 152 KB，只留 coll_code+type）⇒ 开箱即用，无需自备。若要用完整版（835 KB），改成本地完整 CSV 路径即可。"
  },
  "mycobank": {
   "adapter": "MycoBank",
   "path": "data/mycobank_full.tsv"
  },
  "cgmcc": {
   "adapter": "CGMCCAPI",
   "_端点": "https://www.cgmcc.net/cgmccapi/commom/resource/cataloguelist",
   "_限流": "≥1.3 s/请求；结果落盘缓存",
   "path": ".cache"
  },
  "genbank": {
   "adapter": "GenBankAPI",
   "_db": "nucleotide",
   "_限流": "≥1.3 s/请求；结果落盘缓存",
   "path": ".cache"
  },
  "taxonomy": {
   "adapter": "TaxonomyAPI",
   "_db": "taxonomy",
   "path": ".cache"
  },
  "icmp": {
   "adapter": "ICMPAPI",
   "_端点": "https://scd.landcareresearch.co.nz/Search/ResultsPartial?collectionId=ICMP",
   "_详情页": "https://scd.landcareresearch.co.nz/Specimen/ICMP%20<NUM>",
   "_许可": "NZGOAL（新西兰政府开放获取与许可框架）",
   "_限流": "≥1.5 s/请求；结果落盘缓存",
   "path": ".cache"
  },
  "cbsmap": {
   "adapter": "CBSMap",
   "path": "out/cbs_live_20261016.tsv",
   "_说明": "CBS 实时导出（含 other_coll 列），提供「别家号 → CBS 号」反向映射。由 tools/fetch_cbs_live.py 生成；仓库自带的 data/cbs_catalogue.tsv 只有 4 列，没有 other_coll。"
  }
 }
}